# puls3 environment: every variable the server, the scripts and the app read.
#
#   cp .env.example .env      # .env is git-ignored; edit it there
#   set -a; . ./.env; set +a  # export it before running the server or a script
#
# This file holds NO secrets, by design, and neither should your .env: every value
# below is public (network data, contract ids) or the NAME of a Stellar CLI identity
# (stellar keys ls), never a key. The app build reads this same file
# (--dart-define-from-file), so a secret here could end up in the app.
# Secrets live elsewhere: see docs/infra/secrets.md.
#
# Defaults are the public testnet values from contracts/deployments/testnet.json.
# Switching between testnet and a local network is env-only: change the values in
# the "Stellar network" block (a local example is commented out under it).
# Empty means "use the built-in default" (the server falls back to testnet).

# ---------------------------------------------------------------------------
# Server (puls3_server, read from the process environment)
# ---------------------------------------------------------------------------

# Stellar network. Testnet values (the server defaults, see StellarConfig.testnet).
PULS3_STELLAR_RPC_URL=https://soroban-testnet.stellar.org
PULS3_STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
# Stellar Asset Contract (SAC) of the accepted USDC (Circle testnet USDC:
# USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5).
PULS3_STELLAR_USDC_SAC=CBIELTK6YBZJU5UP2WWQEUCYKLPU6AUNZ2BQ4WWFEIE3USCIHMXQDAMA
# Identity Registry and Agent Escrow contract ids (deployments/testnet.json).
PULS3_STELLAR_IDENTITY_REGISTRY=CD5QZOKGRBV35C5SDT6PG7S72XGG4BHQAC2L56YLNBJDUL4LDMTXFIJJ
PULS3_STELLAR_ESCROW=CBRD7A7MXINM7LREKCL3RMKRQ5UMLGKNHAEYY4JT7MVBBB7R5QV4TPE2
# Existing account used only as the source of unsigned simulations. A PUBLIC key,
# not a secret: simulations are never signed or submitted.
PULS3_STELLAR_SIMULATION_SOURCE=GAFUYV5G3SBKIPAFDVAKZVGYNJY3YCMO2KD6OXTU2KYCIEMTM3SMIFKY

# Agent wallet custody (ADR-0003 decision 4). Base64 of a random 32-byte key that
# encrypts custodied agent secrets at rest. This is a SECRET: generate one with
# `openssl rand -base64 32`, set it in your .env, and never commit it. When it is
# unset, creating an agent wallet is refused (custody is unavailable).
PULS3_AGENT_WALLET_SECRET_KEY=

# Local network instead (stellar container start local). Deploy the contracts there
# first and paste their ids; the USDC SAC is the one of an asset you issue locally.
# PULS3_STELLAR_RPC_URL=http://localhost:8000/rpc
# PULS3_STELLAR_NETWORK_PASSPHRASE="Standalone Network ; February 2017"
# PULS3_STELLAR_USDC_SAC=C...
# PULS3_STELLAR_IDENTITY_REGISTRY=C...
# PULS3_STELLAR_ESCROW=C...
# PULS3_STELLAR_SIMULATION_SOURCE=G...

# Chain submission tracker. Only "true" enables it (off by default).
PULS3_TRACKER_ENABLED=false
# Seconds between tracker passes (positive whole number, default 5).
PULS3_TRACKER_INTERVAL_SECONDS=5

# Catalog indexer: syncs the agent catalog index from the identity registry.
# Only "true" enables it (off by default).
PULS3_INDEXER_ENABLED=false
# Seconds between indexer passes (positive whole number, default 30).
PULS3_INDEXER_INTERVAL_SECONDS=30
# Seconds a new hire's escrow job stays valid (expired_at = now + this). Required
# by HireService.createHire, no default: the value is deferred (ADR-0005 D3).
# PULS3_HIRE_JOB_DURATION_SECONDS=
# Seconds an unsigned escrow envelope stays valid (its maxTime). Required by the
# prepare... methods, no default: the value is deferred (ADR-0005 D3).
# PULS3_ESCROW_PREPARATION_VALIDITY_SECONDS=
# Inclusion fee of every prepared envelope, in stroops. Required, no default.
# PULS3_STELLAR_INCLUSION_FEE_STROOPS=
# max_fee_bps of fund (0..1000). Required, no default.
# PULS3_PLATFORM_FEE_BPS=
# Seconds an agent run may take before it fails with "timeout" (positive whole
# number, default 120). Must end before the job's expired_at (ADR-0005 D3, D4).
# PULS3_RUNTIME_TIMEOUT_SECONDS=
# Agent runtime (#20). Only "true" runs the agent of funded hires (off by
# default); it also needs credentials for at least one model provider.
PULS3_RUNTIME_ENABLED=false
# Seconds between agent runtime passes (positive whole number, default 5).
PULS3_RUNTIME_INTERVAL_SECONDS=5
# Cloudflare account id for Workers AI, the free model provider (public, not a
# secret). Its API token is the workersAiApiToken Serverpod password.
PULS3_WORKERS_AI_ACCOUNT_ID=

# Browser origins allowed to call the API, comma-separated, no path. Loopback
# origins (localhost, 127.0.0.1) are always allowed in the development run mode,
# so leave it empty locally. Deployed value: the Cloudflare Pages origin.
PULS3_ALLOWED_ORIGINS=
# Public SEP-10 domains embedded in wallet authentication challenges. Production
# must set the actual home domain and the API host serving wallet authentication.
PULS3_AUTH_HOME_DOMAIN=
PULS3_AUTH_WEB_AUTH_DOMAIN=
# Commit reported by health.check as 1.0.0+<sha>. Set on Serverpod Cloud by the
# pre-deploy script (puls3_server/tool/set_deploy_sha.dart); never set it by hand.
# PULS3_GIT_SHA=

# Serverpod itself. Locally, secrets come from puls3_server/config/passwords.yaml
# (generated by scripts/setup-local-secrets.sh) and the run mode from --mode.
# In a deployment, Serverpod also reads them from these variables. They are
# SECRETS: never set them in this file. Set them in Serverpod Cloud or as GitHub
# secrets (docs/infra/secrets.md). Note: an EMPTY value would override
# passwords.yaml, so keep them commented out here.
# SERVERPOD_RUN_MODE=development
# SERVERPOD_DATABASE_PASSWORD=
# SERVERPOD_REDIS_PASSWORD=
# SERVERPOD_SERVICE_SECRET=
# SERVERPOD_PASSWORD_emailSecretHashPepper=
# SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=
# SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=
#
# Local Docker passwords (POSTGRES_PASSWORD, REDIS_PASSWORD, POSTGRES_TEST_PASSWORD,
# REDIS_TEST_PASSWORD) live in puls3_server/.env, which docker compose loads.
# See puls3_server/.env.example.

# ---------------------------------------------------------------------------
# App (puls3_flutter, compile-time dart-defines)
#   cd puls3_flutter && flutter run --dart-define-from-file=../.env
# ---------------------------------------------------------------------------

# Serverpod API URL. Empty uses assets/config.json (http://localhost:8080).
# The web build served by the server gets its URL from the server instead.
PULS3_API_URL=
# Escrow contract shown in the UI (default: the testnet escrow above).
PULS3_ESCROW_CONTRACT=CBRD7A7MXINM7LREKCL3RMKRQ5UMLGKNHAEYY4JT7MVBBB7R5QV4TPE2

# ---------------------------------------------------------------------------
# Scripts (scripts/*.sh). Testnet only.
# ---------------------------------------------------------------------------

# Stellar CLI identity that deploys the contracts and owns the seeded demo agents.
# Create and fund it once, then put its name here:
#   stellar keys generate <name> --fund --network testnet
# The same goes for the other identity names below (AGENT_WALLET_ACCOUNT, CLIENT_ACCOUNT).
STELLAR_ACCOUNT=
# Network the scripts target. They refuse anything but testnet.
STELLAR_NETWORK=testnet

# deploy-testnet.sh: collection name and symbol for the Identity Registry constructor.
REGISTRY_NAME="Puls3 Agent"
REGISTRY_SYMBOL=P3AGENT

# deploy-escrow-testnet.sh and seed-demo-agents.sh: identity of the agents' wallet
# (default: STELLAR_ACCOUNT).
AGENT_WALLET_ACCOUNT=
# deploy-escrow-testnet.sh --test-job / --direct-payment: client identity (must
# differ from the agent wallet), job expiry in seconds (86400 < n <= 2592000), seed
# agent used as provider (default agt-001), and the hire id used as muxed id.
CLIENT_ACCOUNT=
TEST_JOB_EXPIRY_SECONDS=
TEST_JOB_AGENT=
DIRECT_PAYMENT_HIRE_ID=

# fund-testnet-accounts.sh: Friendbot endpoint, and the scripted test USDC asset
# (identity of its issuer, created on first use; asset code; amount per account in
# stroops, 7 decimals: 1000000000 = 100.00).
FRIENDBOT_URL=
TEST_USDC_ISSUER_ACCOUNT=puls3-test-usdc-issuer
TEST_USDC_CODE=PUSDC
TEST_USDC_AMOUNT=1000000000

# Overrides used by the offline tests (scripts/tests). Leave empty.
# SEED_FILE: seed file (default contracts/deployments/demo-agents.json)
# DEPLOY_RECORD_FILE: deployment record (default contracts/deployments/testnet.json)
# ESCROW_WASM: prebuilt escrow wasm (default: build it)
# SEED_JSON_RT: "node" forces the node JSON branch of seed-demo-agents.sh
SEED_FILE=
DEPLOY_RECORD_FILE=
ESCROW_WASM=
SEED_JSON_RT=

# cloudflare-pages-build.sh: where the Pages build installs Flutter (default
# ./flutter at the repository root). The Pages project sets PULS3_API_URL above.
# PULS3_FLUTTER_DIR=
# cloudflare-pages-build.sh: set to `server` once the server accepts wallet
# sessions so hires move real testnet USDC. Unset keeps the labelled demo.
# PULS3_HIRE=
# cloudflare-pages-build.sh: the SEP-10 values the app checks every sign-in
# challenge against (#136). Required with PULS3_HIRE=server, or the build
# fails. All public: the server's G… account (never its S… secret), and the
# home and web_auth domains, which for the deployed server are both its API
# host (puls3-hub-on-stellar.api.serverpod.space).
# PULS3_AUTH_SERVER_SIGNING_KEY=
# PULS3_AUTH_HOME_DOMAIN=
# PULS3_AUTH_WEB_AUTH_DOMAIN=
